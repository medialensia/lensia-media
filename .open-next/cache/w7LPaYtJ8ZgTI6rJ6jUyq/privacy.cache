{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/privacy/layout,_N_T_/privacy/page,_N_T_/privacy"},"segmentPaths":["/_tree","/_full","/privacy/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/a343f882a40d2cc9-s.p.1sj6eobyi31rd.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0tcvc4llwk9fa.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3l04zcqx63h3y.js\"/><script src=\"/_next/static/chunks/0cegfsgm6lvdz.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mh6a-0e61pyc.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3c3u6qvaizm9n.js\" async=\"\"></script><script src=\"/_next/static/chunks/0pn1ysv-nlkyk.js\" async=\"\"></script><script src=\"/_next/static/chunks/1vckvmn54gy9z.js\" async=\"\"></script><title>Lensia Media | YouTube Growth Agency</title><meta name=\"description\" content=\"Premium YouTube growth agency specializing in thumbnails, editing, SEO and channel strategy.\"/><meta name=\"author\" content=\"Lensia Media\"/><meta name=\"keywords\" content=\"YouTube Growth,YouTube SEO,Thumbnail Design,Video Editing,Channel Strategy,Brand Identity,Lensia Media\"/><meta property=\"og:title\" content=\"Lensia Media | YouTube Growth Agency\"/><meta property=\"og:description\" content=\"Premium YouTube growth agency specializing in thumbnails, editing, SEO and channel strategy.\"/><meta property=\"og:url\" content=\"https://lensiamedia.com\"/><meta property=\"og:site_name\" content=\"Lensia Media\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://lensiamedia.com/og-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Lensia Media — YouTube Growth Agency\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Lensia Media | YouTube Growth Agency\"/><meta name=\"twitter:description\" content=\"Premium YouTube growth agency specializing in thumbnails, editing, SEO and channel strategy.\"/><meta name=\"twitter:image\" content=\"https://lensiamedia.com/og-image.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.1vris5ty3xwpy.ico\" sizes=\"32x32\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5901b7c6-module__ec5Qua__variable manrope_b7d5735e-module__suUhcW__variable\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-[#070B14] text-white\"><section class=\"border-b border-white/10\"><div class=\"mx-auto max-w-5xl px-6 py-20\"><a href=\"/\" class=\"text-sm text-slate-400 transition hover:text-white\">← Back to Home</a><div class=\"mt-8\"><div class=\"inline-flex rounded-full border border-purple-500/30 bg-purple-500/10 px-4 py-1 text-sm text-purple-300\">Legal</div><h1 class=\"mt-6 text-5xl font-extrabold md:text-6xl\">Privacy Policy</h1><p class=\"mt-4 text-slate-400\">Last updated: September 11, 2026</p><p class=\"mt-6 max-w-3xl text-lg leading-8 text-slate-300\">This Privacy Policy explains how Lensia Media collects, uses and protects your personal information when you visit our website or use our creative services.</p></div></div></section><section class=\"mx-auto max-w-5xl px-6 py-16\"><div class=\"space-y-12\"><div><h2 class=\"text-2xl font-bold\">1. Information We Collect</h2><p class=\"mt-4 leading-8 text-slate-300\">We may collect your name, email address, business information and any project details you voluntarily provide through our contact form or email communication.</p></div><div><h2 class=\"text-2xl font-bold\">2. How We Use Your Information</h2><ul class=\"mt-4 space-y-3 text-slate-300\"><li>• <!-- -->Respond to inquiries and project requests.</li><li>• <!-- -->Deliver creative and consulting services.</li><li>• <!-- -->Improve our website and user experience.</li><li>• <!-- -->Send important project-related communications.</li></ul></div><div><h2 class=\"text-2xl font-bold\">3. Cookies</h2><p class=\"mt-4 leading-8 text-slate-300\">Our website may use essential cookies and analytics tools to understand website performance. We do not sell your personal information.</p></div><div><h2 class=\"text-2xl font-bold\">4. Data Sharing</h2><p class=\"mt-4 leading-8 text-slate-300\">We do not sell or rent your personal data. Information is shared only with trusted providers when necessary to deliver our services or comply with legal obligations.</p></div><div><h2 class=\"text-2xl font-bold\">5. Data Security</h2><p class=\"mt-4 leading-8 text-slate-300\">We use reasonable technical and organizational measures to protect your information against unauthorized access, disclosure or misuse.</p></div><div><h2 class=\"text-2xl font-bold\">6. Your Rights</h2><p class=\"mt-4 leading-8 text-slate-300\">You may request access, correction or deletion of your personal data by contacting us.</p></div><div><h2 class=\"text-2xl font-bold\">7. Third-Party Services</h2><p class=\"mt-4 leading-8 text-slate-300\">Our website may contain links to services such as YouTube, Stripe and PayPal. Their privacy policies apply separately.</p></div><div><h2 class=\"text-2xl font-bold\">8. Contact</h2><div class=\"mt-4 rounded-2xl border border-white/10 bg-white/5 p-6\"><p class=\"text-slate-300\">If you have any questions regarding this Privacy Policy, contact us:</p><div class=\"mt-4 space-y-2\"><p class=\"font-semibold text-white\">Lensia Media</p><p class=\"text-slate-400\">lensiamedia@gmail.com</p></div></div></div></div></section></main><!--$--><!--/$--><script src=\"/_next/static/chunks/3l04zcqx63h3y.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[43467,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\"],\\\"LanguageProvider\\\"]\\n3:I[39756,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\"],\\\"default\\\"]\\n5:I[47257,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\"],\\\"ClientPageRoot\\\"]\\n6:I[89064,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\",\\\"/_next/static/chunks/1vckvmn54gy9z.js\\\"],\\\"default\\\"]\\n9:I[97367,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\"],\\\"OutletBoundary\\\"]\\na:\\\"$Sreact.suspense\\\"\\nd:I[97367,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\"],\\\"ViewportBoundary\\\"]\\nf:I[97367,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\"],\\\"MetadataBoundary\\\"]\\n11:I[68027,[\\\"/_next/static/chunks/0pn1ysv-nlkyk.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/0tcvc4llwk9fa.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/a343f882a40d2cc9-s.p.1sj6eobyi31rd.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\nc:X\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"privacy\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"privacy\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{},\\\"$undefined\\\",\\\"$undefined\\\",4608