rl\" content=\"https://lensiamedia.com\"/><meta property=\"og:site_name\" content=\"Lensia Media\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://lensiamedia.com/og-image.jpg\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Lensia Media\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Lensia Media\"/><meta name=\"twitter:description\" content=\"Helping creators grow through strategy, thumbnails and optimization.\"/><meta name=\"twitter:image\" content=\"https://lensiamedia.com/og-image.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.1vris5ty3xwpy.ico\" sizes=\"32x32\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5901b7c6-module__ec5Qua__variable manrope_b7d5735e-module__suUhcW__variable\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-[#070B14] text-white\"><section class=\"border-b border-white/10\"><div class=\"mx-auto max-w-6xl px-6 py-20\"><a href=\"/\" class=\"text-sm text-slate-400 transition hover:text-white\">← Back to Home</a><div class=\"mt-10 max-w-3xl\"><div class=\"inline-flex rounded-full border border-white/10 bg-white/5 px-4 py-1 text-sm text-slate-300\">Partnership Plan</div><h1 class=\"mt-6 text-5xl font-extrabold md:text-7xl\">Performance</h1><p class=\"mt-6 text-xl leading-8 text-slate-300\">A premium partnership package for monetized YouTube creators. You receive our complete Media Pro service with a lower upfront cost.</p><div class=\"mt-10 flex items-end gap-2\"><span class=\"text-6xl font-extrabold\">€95</span><span class=\"pb-2 text-slate-400\">/ month + 15% AdSense</span></div></div></div></section><section class=\"mx-auto max-w-6xl px-6 py-20\"><div class=\"grid gap-12 lg:grid-cols-3\"><div class=\"lg:col-span-2\"><h2 class=\"text-3xl font-bold\">What&#x27;s Included</h2><div class=\"mt-8 grid gap-4 md:grid-cols-2\"><div class=\"rounded-2xl border border-white/10 bg-white/5 p-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-purple-600\">✓</div><span>40 Premium Thumbnails</span></div></div><div class=\"rounded-2xl border border-white/10 bg-white/5 p-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-purple-600\">✓</div><span>Complete YouTube SEO</span></div></div><div class=\"rounded-2xl border border-white/10 bg-white/5 p-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-purple-600\">✓</div><span>Monthly Channel Analysis</span></div></div><div class=\"rounded-2xl border border-white/10 bg-white/5 p-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-purple-600\">✓</div><span>Content Strategy</span></div></div><div class=\"rounded-2xl border border-white/10 bg-white/5 p-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-purple-600\">✓</div><span>Priority Delivery</span></div></div><div class=\"rounded-2xl border border-white/10 bg-white/5 p-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-purple-600\">✓</div><span>Unlimited Revisions</span></div></div><div class=\"rounded-2xl border border-white/10 bg-white/5 p-4\"><div class=\"flex items-center gap-3\"><div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-purple-600\">✓</div><span>24/7 Support</span></div></div></div><div class=\"mt-16\"><h2 class=\"text-3xl font-bold\">Who is this for?</h2><p class=\"mt-5 leading-8 text-slate-300\">Best suited for creators with a monetized YouTube channel who publish consistently and want a long-term growth partner.</p></div><div class=\"mt-16\"><h2 class=\"text-3xl font-bold\">How It Works</h2><div class=\"mt-8 space-y-6\"><div class=\"flex gap-5\"><div class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-purple-600 font-bold\">1</div><div><h3 class=\"text-xl font-semibold\">Channel Audit</h3><p class=\"mt-1 text-slate-400\">We analyze your channel, audience and growth opportunities.</p></div></div><div class=\"flex gap-5\"><div class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-purple-600 font-bold\">2</div><div><h3 class=\"text-xl font-semibold\">Optimization</h3><p class=\"mt-1 text-slate-400\">We create thumbnails and optimize your entire SEO strategy.</p></div></div><div class=\"flex gap-5\"><div class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-purple-600 font-bold\">3</div><div><h3 class=\"text-xl font-semibold\">Scaling</h3><p class=\"mt-1 text-slate-400\">CTR and channel performance are monitored every month.</p></div></div><div class=\"flex gap-5\"><div class=\"flex h-12 w-12 items-center justify-center rounded-xl bg-purple-600 font-bold\">4</div><div><h3 class=\"text-xl font-semibold\">Partnership</h3><p class=\"mt-1 text-slate-400\">You pay €95/month plus 15% of your monthly AdSense revenue.</p></div></div></div></div></div><div><div class=\"sticky top-8 rounded-3xl border border-white/10 bg-white/5 p-6\"><h3 class=\"text-2xl font-bold\">Summary</h3><div class=\"mt-6 space-y-4 text-sm\"><div class=\"flex justify-between\"><span class=\"text-slate-400\">Base Price</span><span>€95</span></div><div class=\"flex justify-between\"><span class=\"text-slate-400\">Revenue Share</span><span>15%</span></div><div class=\"flex justify-between\"><span class=\"text-slate-400\">Delivery</span><span>24–48 Hours</span></div><div class=\"flex justify-betw